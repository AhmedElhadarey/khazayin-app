# Files uploaded to EAS but never bundled into the binary.
# Excluding them speeds up every build (was ~62MB of design source).

# Design spec / mocks — referenced only in code comments, never required
design_source/

# Track workflow history & planning docs
conductor/
docs/

# Local Expo cache & build artifacts
.expo/
web-build/
dist/

# Dev tooling
.claude/
.vscode/

# Tests (not needed in the production bundle)
**/__tests__/
**/*.test.ts
**/*.test.tsx

# Native BUILD OUTPUTS. The native sources themselves are deliberately NOT
# excluded: android/ and ios/ are gitignored, but EAS is told to build from
# them so the cloud build is the same project that was verified on device,
# rather than a fresh cloud prebuild that could differ. Only the generated
# artefacts are dropped — EAS runs `pod install` and Gradle itself.
#
# Without this the archive was 978MB (android/app/build alone is ~2.4GB).
android/app/build/
android/app/.cxx/
android/build/
android/.gradle/
android/.kotlin/
ios/Pods/
ios/build/
ios/DerivedData/
*.apk
*.aab

# Machine-local SDK path. Generated for the local Gradle build and MUST NOT be
# uploaded: it names this Mac's SDK directory, which does not exist on the EAS
# builder, producing "sdk.dir property in local.properties: Directory does not
# exist" on every cloud build.
android/local.properties
