# Sentry crash/error reporting. EXPO_PUBLIC_* vars are inlined into the app
# bundle at build time (local `expo start` and EAS builds alike).
# A Sentry DSN is a public client key — safe to commit; it only permits
# sending events, not reading them.
EXPO_PUBLIC_SENTRY_DSN=https://8df1901192716bb7dfb7b3ce08f2e456@o4510874142244864.ingest.us.sentry.io/4511578443874304

# Privacy policy shown from Settings → سياسة الخصوصية in the in-app browser.
# https only. Unset = the app shows "ستُضاف قريبًا". Public URL, safe to commit.
# EXPO_PUBLIC_PRIVACY_POLICY_URL=
