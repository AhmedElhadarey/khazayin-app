{
  "expo": {
    "name": "مكتبة خزائن الرحمن",
    "slug": "khazayin-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-khazain.png",
    "scheme": "khazayinapp",
    "userInterfaceStyle": "automatic",
    "extra": {
      "rtl": true
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F3C61",
        "foregroundImage": "./assets/images/android-icon-foreground-khazain.png",
        "backgroundImage": "./assets/images/android-icon-background-khazain.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-khazain.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-khazain.png",
          "imageWidth": 393,
          "resizeMode": "cover",
          "backgroundColor": "#F5EDE4",
          "dark": {
            "backgroundColor": "#121212"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
